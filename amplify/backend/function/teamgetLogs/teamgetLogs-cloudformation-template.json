{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda Function resource stack creation using Amplify CLI",
  "Parameters": {
    "CloudWatchRule": {
      "Type": "String",
      "Default": "NONE",
      "Description": " Schedule Expression"
    },
    "deploymentBucketName": {
      "Type": "String"
    },
    "env": {
      "Type": "String"
    },
    "customcloudtrailLakeEventDataStoreOutput": {
      "Type": "String"
    },
    "s3Key": {
      "Type": "String"
    },
    "apiteamGraphQLAPIIdOutput": {
      "Type": "String",
      "Default": "apiteamGraphQLAPIIdOutput"
    },
    "apiteamGraphQLAPIEndpointOutput": {
      "Type": "String",
      "Default": "apiteamGraphQLAPIEndpointOutput"
    },
    "AuditMode": {
      "Type": "String",
      "Default": "cloudtrail_lake",
      "Description": "Audit backend mode: cloudtrail_lake or athena"
    },
    "AthenaRoleArn": {
      "Type": "String",
      "Default": "",
      "Description": "ARN of the cross-account IAM role for Athena access"
    },
    "AthenaWorkgroup": {
      "Type": "String",
      "Default": "team-audit",
      "Description": "Athena workgroup name"
    },
    "AthenaDatabase": {
      "Type": "String",
      "Default": "team_cloudtrail_db",
      "Description": "Athena Glue database name"
    },
    "AthenaTable": {
      "Type": "String",
      "Default": "cloudtrail_logs",
      "Description": "Athena Glue table name"
    },
    "AthenaResultsBucket": {
      "Type": "String",
      "Default": "",
      "Description": "S3 bucket for Athena query results"
    },
    "AthenaCloudTrailBucket": {
      "Type": "String",
      "Default": "",
      "Description": "S3 bucket containing CloudTrail logs"
    },
    "AthenaCloudTrailPrefix": {
      "Type": "String",
      "Default": "",
      "Description": "S3 prefix for CloudTrail logs"
    },
    "AthenaKmsKeyArn": {
      "Type": "String",
      "Default": "",
      "Description": "KMS key ARN for Athena encryption"
    },
    "BedrockAuditEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"],
      "Description": "Whether Bedrock AI audit feature is enabled"
    },
    "functionteamBedrockAnalyzerArn": {
      "Type": "String",
      "Default": "",
      "Description": "ARN of the teamBedrockAnalyzer Lambda function (from Amplify dependency)"
    }
  },
  "Conditions": {
    "ShouldNotCreateEnvResources": {
      "Fn::Equals": [
        {
          "Ref": "env"
        },
        "NONE"
      ]
    },
    "IsAthenaMode": {
      "Fn::Equals": [
        {
          "Ref": "AuditMode"
        },
        "athena"
      ]
    },
    "IsBedrockEnabled": {
      "Fn::Equals": [
        {
          "Ref": "BedrockAuditEnabled"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "LambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Metadata": {
        "aws:asset:path": "./src",
        "aws:asset:property": "Code"
      },
      "Properties": {
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "S3Bucket": {
            "Ref": "deploymentBucketName"
          },
          "S3Key": {
            "Ref": "s3Key"
          }
        },
        "Handler": "index.handler",
        "FunctionName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "teamgetLogs",
            {
              "Fn::Join": [
                "",
                [
                  "teamgetLogs",
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "Environment": {
          "Variables": {
            "ENV": {
              "Ref": "env"
            },
            "REGION": {
              "Ref": "AWS::Region"
            },
            "EVENT_DATA_STORE": {
              "Ref": "customcloudtrailLakeEventDataStoreOutput"
            },
            "API_AWSPIM_GRAPHQLAPIIDOUTPUT": {
              "Ref": "apiteamGraphQLAPIIdOutput"
            },
            "API_TEAM_GRAPHQLAPIENDPOINTOUTPUT": {
              "Ref": "apiteamGraphQLAPIEndpointOutput"
            },
            "SESSIONS_TABLE_NAME": {
              "Fn::ImportValue": {
                "Fn::Sub": "${apiteamGraphQLAPIIdOutput}:GetAtt:sessionsTable:Name"
              }
            },
            "AUDIT_MODE": {
              "Ref": "AuditMode"
            },
            "ATHENA_ROLE_ARN": {
              "Ref": "AthenaRoleArn"
            },
            "ATHENA_WORKGROUP": {
              "Ref": "AthenaWorkgroup"
            },
            "ATHENA_DATABASE": {
              "Ref": "AthenaDatabase"
            },
            "ATHENA_TABLE": {
              "Ref": "AthenaTable"
            },
            "ATHENA_RESULTS_BUCKET": {
              "Ref": "AthenaResultsBucket"
            },
            "ATHENA_CLOUDTRAIL_BUCKET": {
              "Ref": "AthenaCloudTrailBucket"
            },
            "ATHENA_CLOUDTRAIL_PREFIX": {
              "Ref": "AthenaCloudTrailPrefix"
            },
            "ATHENA_KMS_KEY_ARN": {
              "Ref": "AthenaKmsKeyArn"
            },
            "BEDROCK_AUDIT_ENABLED": {
              "Ref": "BedrockAuditEnabled"
            },
            "BEDROCK_ANALYZER_FUNCTION_ARN": {
              "Ref": "functionteamBedrockAnalyzerArn"
            },
            "BEDROCK_SCHEDULER_ROLE_ARN": {
              "Fn::If": [
                "IsBedrockEnabled",
                {
                  "Fn::GetAtt": [
                    "BedrockAutoAnalysisSchedulerRole",
                    "Arn"
                  ]
                },
                ""
              ]
            }
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs22.x",
        "Layers": [],
        "Timeout": 250
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "teamapplicationLambdaRole5fbe17a6",
            {
              "Fn::Join": [
                "",
                [
                  "teamapplicationLambdaRole5fbe17a6",
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        }
      }
    },
    "lambdaexecutionpolicy": {
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "lambda-execution-policy",
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:logs:${region}:${account}:log-group:/aws/lambda/${lambda}:log-stream:*",
                  {
                    "region": {
                      "Ref": "AWS::Region"
                    },
                    "account": {
                      "Ref": "AWS::AccountId"
                    },
                    "lambda": {
                      "Ref": "LambdaFunction"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "LambdaTriggerPolicysessions": {
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "amplify-lambda-execution-policy-sessions",
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:DescribeStream",
                "dynamodb:GetRecords",
                "dynamodb:GetShardIterator",
                "dynamodb:ListStreams"
              ],
              "Resource": {
                "Fn::ImportValue": {
                  "Fn::Sub": "${apiteamGraphQLAPIIdOutput}:GetAtt:sessionsTable:StreamArn"
                }
              }
            }
          ]
        }
      }
    },
    "LambdaEventSourceMappingsessions": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "DependsOn": [
        "LambdaTriggerPolicysessions",
        "LambdaExecutionRole"
      ],
      "Properties": {
        "BatchSize": 100,
        "Enabled": true,
        "EventSourceArn": {
          "Fn::ImportValue": {
            "Fn::Sub": "${apiteamGraphQLAPIIdOutput}:GetAtt:sessionsTable:StreamArn"
          }
        },
        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{ \"eventName\": [\"INSERT\"]}"
            }
          ]
        },
        "BisectBatchOnFunctionError": true,
        "MaximumRetryAttempts": 3,
        "FunctionName": {
          "Fn::GetAtt": [
            "LambdaFunction",
            "Arn"
          ]
        },
        "StartingPosition": "LATEST"
      }
    },
    "AmplifyResourcesPolicy": {
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "amplify-lambda-execution-policy",
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "appsync:GraphQL"
              ],
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:appsync:",
                      {
                        "Ref": "AWS::Region"
                      },
                      ":",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":apis/",
                      {
                        "Ref": "apiteamGraphQLAPIIdOutput"
                      },
                      "/types/Query/*"
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:appsync:",
                      {
                        "Ref": "AWS::Region"
                      },
                      ":",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":apis/",
                      {
                        "Ref": "apiteamGraphQLAPIIdOutput"
                      },
                      "/types/Mutation/*"
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:appsync:",
                      {
                        "Ref": "AWS::Region"
                      },
                      ":",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":apis/",
                      {
                        "Ref": "apiteamGraphQLAPIIdOutput"
                      },
                      "/types/Subscription/*"
                    ]
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "CustomLambdaExecutionPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "custom-lambda-execution-policy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "cloudtrail:DescribeQuery",
                "cloudtrail:StartQuery",
                "cloudtrail:GetQueryResults"
              ],
              "Resource": [
                "*"
              ],
              "Effect": "Allow"
            }
          ]
        },
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ]
      },
      "DependsOn": "LambdaExecutionRole"
    },
    "AthenaAssumeRolePolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "IsAthenaMode",
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Properties": {
        "PolicyName": "athena-assume-role-policy",
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:AssumeRole"
              ],
              "Resource": [
                {
                  "Ref": "AthenaRoleArn"
                }
              ]
            }
          ]
        }
      }
    },
    "BedrockAutoAnalysisSchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "IsBedrockEnabled",
      "Properties": {
        "RoleName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "teamBedrockAutoAnalysisSchedulerRole",
            {
              "Fn::Join": [
                "",
                [
                  "teamBedrockAutoAnalysisSchedulerRole",
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeBedrockAnalyzerLambda",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Ref": "functionteamBedrockAnalyzerArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BedrockSchedulerPolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "IsBedrockEnabled",
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Properties": {
        "PolicyName": "bedrock-scheduler-policy",
        "Roles": [
          {
            "Ref": "LambdaExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "scheduler:CreateSchedule"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/default/team-auto-analysis-*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:PassRole"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BedrockAutoAnalysisSchedulerRole",
                    "Arn"
                  ]
                }
              ],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "scheduler.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Name": {
      "Value": {
        "Ref": "LambdaFunction"
      }
    },
    "Arn": {
      "Value": {
        "Fn::GetAtt": [
          "LambdaFunction",
          "Arn"
        ]
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "LambdaExecutionRole": {
      "Value": {
        "Ref": "LambdaExecutionRole"
      }
    },
    "LambdaExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "LambdaExecutionRole",
          "Arn"
        ]
      }
    }
  }
}
